# Fictional local demonstration only. These are public development placeholders, not secrets.
POSTGRES_DB=amanah_demo
POSTGRES_USER=amanah_demo
POSTGRES_PASSWORD=demo-local-only
WEB_PORT=13000
API_PORT=18000
DB_PORT=15432
# Optional native API configuration; Compose fixes demonstration mode to true.
AMANAH_DEMO_ONLY=true
AMANAH_WEB_ORIGIN=http://localhost:13000
AMANAH_COOKIE_SECURE=false
# Demo behavior only; not approved retention periods. Defaults shown.
AMANAH_SESSION_TTL_SECONDS=1800
AMANAH_INVITATION_TTL_SECONDS=600
AMANAH_CONSENT_TTL_SECONDS=1800
AMANAH_LOGIN_LIMIT=5
AMANAH_INVITATION_LIMIT=5
AMANAH_RATE_WINDOW_SECONDS=60
DEMO_WEB_ORIGIN=http://localhost:13000
AMANAH_DATABASE_URL=postgresql+psycopg://amanah_demo:demo-local-only@127.0.0.1:15432/amanah_demo
