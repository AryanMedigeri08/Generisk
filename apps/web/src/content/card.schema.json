{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generisk demonstration lesson card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "version",
    "language",
    "reading_level",
    "title",
    "body",
    "widget",
    "sources",
    "review_status",
    "source_check",
    "glossary_terms"
  ],
  "properties": {
    "card_id": { "type": "string", "pattern": "^m[1-7]-[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "const": "en" },
    "reading_level": { "enum": ["simple", "detail"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "body": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "widget": {
      "enum": [
        "gene-keys",
        "next-100",
        "one-pregnancy",
        "family-tree",
        "negative-bar",
        "uncertain-result",
        "options",
        "none"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "review_status": { "const": "demo-unreviewed" },
    "source_check": { "enum": ["verified", "not_verified"] },
    "glossary_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
